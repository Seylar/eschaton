#!/usr/bin/env bash
# Installeur Eschaton — spec docs/superpowers/specs/2026-08-27-socle-design.md §4.
# S'exécute depuis un environnement live Arch : l'ISO Eschaton (SP4b-1), où il est
# déjà présent en /usr/local/bin, ou un live tiers (archboot aarch64, ISO Arch x86_64).
set -euo pipefail
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib.sh
source "$(dirname "$0")/lib.sh"

usage() {
  echo "usage: eschaton-install [--dry-run] --disk /dev/X --user NOM [--hostname H]" >&2
}

DRY_RUN=0; DISK=""; HOSTNAME_="eschaton"; USERNAME=""
disk_vu=0; hote_vu=0; user_vu=0
while [[ $# -gt 0 ]]; do
  # `--option=valeur` est acceptée au même titre que `--option valeur` : la
  # première forme est courante et se faisait rejeter en « option inconnue »,
  # un message qui accuse l'option alors que seule sa FORME posait problème.
  opt="$1"; val=""; colle=0
  if [[ "$opt" == --*=* ]]; then val="${opt#*=}"; opt="${opt%%=*}"; colle=1; fi
  case "$opt" in
    --dry-run)
      ((colle == 0)) || { echo "eschaton-install : --dry-run n'attend pas de valeur." >&2; usage; exit 1; }
      DRY_RUN=1 ;;
    # `$# -ge 2` avant de consommer $2 : sans ce test, `--disk` en DERNIER token
    # fait échouer le script sur « $2: unbound variable » sous `set -u` — un
    # message de bash, pas de nous, qui n'apprend rien à celui qui installe.
    --disk|--hostname|--user)
      if ((colle == 0)); then
        [[ $# -ge 2 ]] || { echo "eschaton-install : $opt attend un argument." >&2; usage; exit 1; }
        val="$2"; shift
      fi
      [[ -n "$val" ]] || { echo "eschaton-install : $opt attend un argument." >&2; usage; exit 1; }
      # Une option de valeur RÉPÉTÉE est refusée. `--disk /dev/sda --disk
      # /dev/sdb` retenait silencieusement la dernière : sur la seule opération
      # irréversible du dépôt, deviner laquelle des deux cibles est la bonne
      # n'est pas un service à rendre.
      case "$opt" in
        --disk)
          ((disk_vu == 0)) || { echo "eschaton-install : --disk indiqué plusieurs fois (« $DISK » puis « $val »)." >&2
                                echo "  Le disque désigné est EFFACÉ : on refuse de choisir à votre place." >&2; exit 1; }
          disk_vu=1; DISK="$val" ;;
        --hostname)
          ((hote_vu == 0)) || { echo "eschaton-install : --hostname indiqué plusieurs fois (« $HOSTNAME_ » puis « $val »)." >&2; exit 1; }
          hote_vu=1; HOSTNAME_="$val" ;;
        --user)
          ((user_vu == 0)) || { echo "eschaton-install : --user indiqué plusieurs fois (« $USERNAME » puis « $val »)." >&2; exit 1; }
          user_vu=1; USERNAME="$val" ;;
      esac ;;
    *) echo "option inconnue : $1" >&2; usage; exit 1 ;;
  esac
  shift
done
export DRY_RUN
[[ -n "$DISK" && -n "$USERNAME" ]] || { usage; exit 1; }

# Validation AVANT toute écriture : ces trois valeurs finissent dans des
# commandes privilégiées et dans des fichiers de configuration du système cible.
# Le disque, en plus, est effacé sans confirmation à l'étape 1 — se tromper de
# cible est la seule erreur de cet installeur qui ne se rattrape pas.
valider_utilisateur "$USERNAME"
valider_hote "$HOSTNAME_"
# `valider_disque` remplace l'ancien `[[ -b "$DISK" ]]`, qui ne vérifiait RIEN
# de ce que son message promettait, et rend le chemin canonique : c'est lui,
# et non le lien /dev/disk/by-id/… fourni, dont les partitions se dérivent.
#
# La répétition à blanc passe par la MÊME garde dès que le périphérique existe
# ici. Elle la sautait entièrement, et ce que le commentaire présentait comme un
# filet — `valider_noms_partitions` — n'en est pas un : son test
# `"$p" == "$disque"[0-9p]*` est satisfait par « /dev/sda1 » → « /dev/sda1p1 ».
# Résultat mesuré : `--dry-run --disk /dev/sda1` rendait `status 0` et annonçait
# « sgdisk --zap-all /dev/sda1 », que le chemin réel refuse ; un lien by-id
# donnait « attendre_bloc …_1234561 » là où le réel écrit « /dev/nvme0n1p1 »
# (ou « …-part1 » côté udev). La répétition mentait sur les trois entrées mêmes
# qui ont motivé la garde — alors que sa raison d'être est de DIRE À L'AVANCE ce
# qui va se passer. Elle ne peut pas valider ce que le chemin réel refuse.
#
# Disque absent (répétition depuis un autre poste) : il n'y a rien à interroger.
# On juge alors la FORME du nom, et on le DIT — c'est moins que la garde
# complète, ce n'est pas rien, et ce n'est plus un mensonge.
if [[ "$DRY_RUN" == "0" || -b "$DISK" ]]; then
  DISK="$(valider_disque "$DISK")"
else
  valider_forme_disque "$DISK"
  echo "eschaton-install : répétition à blanc — « $DISK » est absent de cette machine." >&2
  echo "  Seule la FORME du nom a pu être vérifiée : ni le type réel (disque," >&2
  echo "  partition, volume LVM, chiffré), ni la canonisation d'un lien. Le chemin" >&2
  echo "  réel, lui, les vérifie et peut donc encore refuser cette cible." >&2
fi

# Précondition spec §4.2 : boot UEFI uniquement
if [[ "$DRY_RUN" == "0" && ! -d /sys/firmware/efi ]]; then
  echo "eschaton-install : boot UEFI requis (dossier /sys/firmware/efi absent)." >&2; exit 1
fi

arch="$(detect_arch)"
kernels="$(kernel_pkgs_for "$arch")"
keyrings="$(keyring_pkgs_for "$arch")"
if [[ "$arch" == "x86_64" && "$DRY_RUN" == "0" ]]; then
  kernels="linux $(microcode_for_cpu)"
fi

# 1. Partitionnement (spec §4.3) — ESP 4 Gio + btrfs sur le reste
# 4 Gio et pas 2 : limine-snapper-sync cesse d'ajouter des entrées de snapshot
# au-delà de LIMIT_USAGE_PERCENT (85 % par défaut) de l'ESP, et chaque snapshot
# amarré au menu y stocke son kernel et son initramfs. Trop petit = filet de
# sécurité qui s'arrête en silence.
part() { nom_partition "$DISK" "$1"; }
# TOUTE la validation dérivée précède le premier appel destructeur : les noms
# des partitions se déduisent du nom du disque, et cette déduction n'était
# confrontée au réel qu'APRÈS `sgdisk --zap-all` — l'installeur détruisait
# d'abord et abandonnait ensuite. Rien d'irréversible ne doit précéder une
# validation complète.
PART_ESP="$(part 1)"; PART_ROOT="$(part 2)"
valider_noms_partitions "$DISK" "$PART_ESP" "$PART_ROOT"

# `relire_table` vit dans lib.sh : le chemin réel demande un Linux (UEFI, un vrai
# disque, blockdev), donc la seule façon d'éprouver ses messages depuis le poste
# de développement est de pouvoir la sourcer.

# Garde AVANT la première écriture : si le noyau ne peut pas relire la table de
# partitions, c'est que le disque est OCCUPÉ — y compris la clé USB depuis
# laquelle on a démarré. On refuse d'effacer un disque en service.
relire_table "$DISK" "avant le partitionnement" intact

run_cmd sgdisk --zap-all "$DISK"
run_cmd sgdisk -n1:0:+4G -t1:ef00 -c1:ESP "$DISK"
run_cmd sgdisk -n2:0:0 -t2:8300 -c2:eschaton "$DISK"

# La relecture de la table de partitions par le noyau est ASYNCHRONE. `sgdisk`
# rend la main avant que /dev/<disque>1 n'existe : sans attente, le `mkfs.vfat`
# ci-dessous échoue par intermittence, et d'autant plus rarement que la machine
# est rapide — donc jamais en VM et parfois sur du vrai matériel.
#
# Trois gardes, et il en faut trois :
#  1. `blockdev --rereadpt` — la seule DÉTECTION réelle. `sgdisk` peut rendre 0
#     en avertissant que le noyau n'a pas relu la table ; les anciens nœuds
#     /dev/sdX1 survivent alors au partitionnement, l'attente ci-dessous les
#     prend pour les nouveaux et `mkfs.vfat` formate l'ANCIENNE géométrie.
#     BLKRRPART rend EBUSY dans ce cas : c'est le `partprobe` que prescrivait le
#     plan Task 2.3, avec util-linux (déjà tiré par `base`) au lieu de parted.
#  2. `udevadm settle` — vide la file d'événements udev.
#  3. `attendre_bloc` — `settle` ne garantit pas que l'événement d'ajout de
#     partition soit DÉJÀ dans la file au moment où on l'appelle.
# Troisième argument : à ce point les trois `sgdisk` ont eu lieu. Le message ne
# peut plus dire « rien n'a été écrit » — il le disait, et un utilisateur dont la
# table vient d'être effacée pouvait en conclure qu'il n'y avait rien à récupérer.
relire_table "$DISK" "après le partitionnement" table-reecrite
run_cmd udevadm settle
run_cmd attendre_bloc "$PART_ESP"
run_cmd attendre_bloc "$PART_ROOT"

run_cmd mkfs.vfat -F32 -n ESP "$PART_ESP"
run_cmd mkfs.btrfs -f -L eschaton "$PART_ROOT"

# 2. Subvolumes
run_cmd mount "$PART_ROOT" /mnt
for sv in @ @home @log @pkg @snapshots; do run_cmd btrfs subvolume create "/mnt/$sv"; done
run_cmd umount /mnt
opts="compress=zstd:1,noatime"
run_cmd mount -o "subvol=@,$opts" "$PART_ROOT" /mnt
run_cmd mkdir -p /mnt/home /mnt/var/log /mnt/var/cache/pacman/pkg /mnt/.snapshots /mnt/boot
run_cmd mount -o "subvol=@home,$opts" "$PART_ROOT" /mnt/home
run_cmd mount -o "subvol=@log,$opts" "$PART_ROOT" /mnt/var/log
run_cmd mount -o "subvol=@pkg,$opts" "$PART_ROOT" /mnt/var/cache/pacman/pkg
run_cmd mount -o "subvol=@snapshots,$opts" "$PART_ROOT" /mnt/.snapshots
run_cmd mount "$PART_ESP" /mnt/boot

# 3. Dépôt [eschaton] dans le live env, puis pacstrap
# Idempotent : sur l'ISO Eschaton le dépôt est DÉJÀ déclaré (le profil archiso
# livre le même bloc et le même fichier de miroir), les deux commandes ne font
# alors que constater. Sur un live tiers, elles l'installent.
run_cmd bash -c 'grep -q "^\[eschaton\]" /etc/pacman.conf || printf "\n[eschaton]\nSigLevel = Optional TrustAll\nInclude = /etc/pacman.d/eschaton-mirror\n" >> /etc/pacman.conf'
# Le `\$` est indispensable : `$arch` doit atterrir LITTÉRALEMENT dans le
# fichier, c'est pacman qui le substitue (dépôt publié par architecture,
# spec §5.3). Sans l'échappement, le `bash -c` l'expanserait ici — et en vide,
# puisque la variable `arch` de ce script n'est pas exportée.
# shellcheck disable=SC2016  # non-expansion voulue : voir ci-dessus
run_cmd bash -c 'echo "Server = https://seylar.github.io/eschaton/\$arch" > /etc/pacman.d/eschaton-mirror'
# shellcheck disable=SC2086
run_cmd pacstrap -K /mnt base $kernels $keyrings eschaton-base eschaton-branding
run_cmd bash -c 'genfstab -U /mnt >> /mnt/etc/fstab'

# 4. Configuration dans le chroot (spec §4.2 étape 5 + provisioning autorisé)
chroot_cmd() { run_cmd arch-chroot /mnt bash -c "$1"; }
# Signer localement les clés des trousseaux installés à l'étape 3. Le `-K` de
# pacstrap amorce bien un trousseau, mais avec les trousseaux de
# l'ENVIRONNEMENT LIVE ; les clés apportées par le paquet trousseau de la cible
# n'y sont pas encore. Sans ce `--populate`, la clé ALARM se retrouve dans le
# trousseau sans autre signature que la sienne — donc non fiable (constat
# Task 9). Idempotent : `--init` ne recrée pas une clé maîtresse existante.
chroot_cmd 'pacman-key --init && pacman-key --populate'
chroot_cmd 'ln -sf /usr/share/zoneinfo/Europe/Paris /etc/localtime && hwclock --systohc || true'
chroot_cmd 'sed -i "s/^#fr_FR.UTF-8/fr_FR.UTF-8/; s/^#en_US.UTF-8/en_US.UTF-8/" /etc/locale.gen && locale-gen'
chroot_cmd 'echo LANG=fr_FR.UTF-8 > /etc/locale.conf && echo KEYMAP=fr > /etc/vconsole.conf'
# `write_file` et non `bash -c "echo '$HOSTNAME_' > …"` : plus aucune valeur
# fournie par l'utilisateur n'est interpolée dans du code shell (cf. lib.sh).
write_file /mnt/etc/hostname "$HOSTNAME_"
# `rm -f` d'abord : /etc/os-release est un LIEN SYMBOLIQUE vers
# ../usr/lib/os-release (paquet `filesystem`). Sans la suppression, le `cp` suit
# le lien et écrase /usr/lib/os-release — un fichier que `filesystem` possède et
# qui ne figure pas dans son `backup=` : la prochaine mise à jour de `filesystem`
# le restaure en silence et le système redevient « Arch Linux ARM » (constat
# Task 9). En remplaçant le lien par un vrai fichier, l'identité vit dans /etc,
# qui prime sur /usr/lib pour tous les consommateurs (os-release(5)).
chroot_cmd 'rm -f /etc/os-release && cp /usr/share/eschaton/os-release /etc/os-release'
# Provisioning autorisé (spec §3) : activer le dépôt [eschaton] sur le système cible
chroot_cmd 'grep -q "eschaton.conf" /etc/pacman.conf || printf "\nInclude = /etc/pacman.d/eschaton.conf\n" >> /etc/pacman.conf'
chroot_cmd 'sed -i "s/^SNAPPER_CONFIGS=.*/SNAPPER_CONFIGS=\"root\"/" /etc/conf.d/snapper'
# Appel direct, sans `bash -c` : le nom d'utilisateur n'est plus interpolé dans
# une chaîne de commande, il est passé comme argument.
run_cmd arch-chroot /mnt useradd -m -G wheel "$USERNAME"
if [[ "$DRY_RUN" == "0" ]]; then arch-chroot /mnt passwd "$USERNAME"; else echo "DRY: passwd $USERNAME"; fi
chroot_cmd 'systemctl preset-all'

# 5. Limine (UEFI, chemin de boot par défaut)
# Les noms des fichiers posés dans /boot ne se déduisent PAS du nom du paquet
# kernel. Constaté paquet par paquet (Task 7, step 6) :
#   x86_64  — Arch `linux` ne livre que usr/lib/modules/<kver>/vmlinuz ; c'est le
#     hook mkinitcpio (90-mkinitcpio-install.hook, modèle hook.preset) qui pose
#     /boot/vmlinuz-linux et /boot/initramfs-linux.img.
#   aarch64 — ALARM `linux-aarch64` livre directement /boot/Image (aucun
#     vmlinuz-*, aucun usr/lib/modules/<kver>/vmlinuz) et son preset écrit
#     /boot/initramfs-linux.img — pas initramfs-linux-aarch64.img.
kernel_name="${kernels%% *}"
if [[ "$arch" == "aarch64" ]]; then
  efi=BOOTAA64.EFI; kernel_file="Image";                initramfs_file="initramfs-linux.img"
else
  efi=BOOTX64.EFI;  kernel_file="vmlinuz-$kernel_name"; initramfs_file="initramfs-$kernel_name.img"
fi
chroot_cmd "mkdir -p /boot/EFI/BOOT && cp /usr/share/limine/$efi /boot/EFI/BOOT/$efi"
# STRUCTURE IMBRIQUÉE — exigée par limine-snapper-sync, donc par le filet de
# sécurité tout entier (spec §6). Le nombre de `/` donne le niveau :
#
#   /Eschaton          ← l'entrée « OS », celle que TARGET_OS_NAME désigne
#       //<kernel>     ← au moins UNE sous-entrée de kernel : obligatoire
#       //Snapshots    ← l'ancre où l'outil écrit les entrées de snapshot
#
# Une entrée PLATE (les clés du kernel directement sous `/Eschaton`) est
# acceptée par Limine et démarre parfaitement — mais limine-snapper-sync la
# refuse avec « Your OS entry has no kernel in /boot/limine.conf » et n'écrit
# JAMAIS la moindre entrée de snapshot (constat Task 9). Le système démarre, le
# filet de sécurité est absent, et rien ne le signale : exactement la panne
# muette contre laquelle la spec §6 existe.
#
# `//Snapshots` est facultatif pour l'outil (à défaut il écrit dans l'entrée OS)
# mais on le pose explicitement : l'ancre rend visible, dans le fichier même,
# l'endroit où le filet s'accroche.
#
# À noter : sur aarch64 rien ne régénère ce fichier — `limine-update`
# (limine-entry-tool) s'arrête sur « The system is not x86_64 ». Les chemins
# ci-dessous sont donc définitifs, ce qui est sans risque : le paquet
# linux-aarch64 d'ALARM réécrit toujours /boot/Image et /boot/initramfs-linux.img
# sous les mêmes noms.
#
# `default_entry` est la contrepartie OBLIGATOIRE de l'imbrication : une entrée
# de premier niveau qui contient des sous-entrées n'est plus amorçable, c'est un
# sous-menu. À l'expiration du `timeout`, Limine n'a alors rien à démarrer et
# reste sur son menu, indéfiniment — une VM sans clavier ne démarre plus du tout
# (constat Task 9, au redémarrage qui a suivi le passage à l'imbrication).
# On désigne la sous-entrée par son CHEMIN (`Eschaton/<kernel>`) et non par son
# index : limine-snapper-sync insère des entrées de snapshot, donc tout numéro
# se décalerait au premier snapshot venu.
run_cmd bash -c "cat > /mnt/boot/limine.conf <<EOF
timeout: 3
default_entry: Eschaton/$kernel_name

/Eschaton
    //$kernel_name
        protocol: linux
        path: boot():/$kernel_file
        module_path: boot():/$initramfs_file
        cmdline: root=LABEL=eschaton rootflags=subvol=@ rw quiet

    //Snapshots
EOF"

# 6. Vérification post-install — /boot doit être complet AVANT de dire « terminé ».
# Motif : limine-mkinitcpio-hook installe un wrapper mkinitcpio dans
# /usr/local/bin qui ne propage pas les codes de retour (constat Task 6) ; un
# initramfs non généré pendant pacstrap passerait sinon totalement inaperçu, et
# l'installeur annoncerait un succès sur un système qui ne démarre pas.
verify_path() { # $1 = motif (glob accepté), $2 = ce qu'on attend
  if [[ "$DRY_RUN" == "1" ]]; then echo "DRY: test -e $1   # $2"; return 0; fi
  if compgen -G "$1" >/dev/null; then echo "    ok : $2 ($1)"; return 0; fi
  echo "eschaton-install : $2 introuvable — aucun fichier ne correspond à $1." >&2
  return 1
}

echo "==> Vérification de /mnt/boot"
verify_failed=0
# On vérifie exactement les fichiers que limine.conf référence : un contrôle plus
# lâche (vmlinuz-*) passerait au vert sur aarch64 alors que le kernel s'y appelle
# Image, c'est-à-dire précisément le faux succès qu'on veut interdire.
verify_path "/mnt/boot/$kernel_file"       "le kernel"                  || verify_failed=1
verify_path "/mnt/boot/$initramfs_file"    "l'initramfs"                || verify_failed=1
verify_path "/mnt/boot/EFI/BOOT/$efi"      "le binaire EFI de Limine"   || verify_failed=1
verify_path "/mnt/boot/limine.conf"        "la configuration de Limine" || verify_failed=1
if [[ "$verify_failed" != "0" ]]; then
  echo "eschaton-install : /boot est INCOMPLET — le système ne démarrerait pas." >&2
  echo "Ne redémarre pas : corrige les manques ci-dessus (chroot : arch-chroot /mnt)," >&2
  echo "puis relance la génération concernée (mkinitcpio -P, réinstallation du kernel...)." >&2
  exit 1
fi

# 7. Vérification post-install — les actions polkit qui CONTRAIGNENT les
# binaires privilégiés du socle.
#
# Deux façons de perdre la contrainte, et aucune ne se voit à l'œil nu :
#
#   a) l'action n'est pas livrée. `pkexec` ne refuse alors PAS : il retombe sur
#      l'action générique `org.freedesktop.policykit.exec`, dont les
#      `<defaults>` valent `auth_admin` sur les trois axes — `allow_any` et
#      `allow_inactive` compris — là où les nôtres posent `no`. Une session
#      distante ou inactive, à qui nos actions n'offrent aucun chemin
#      d'authentification, en retrouve un. C'était le cas jusqu'au 2026-08-30 :
#      les binaires venaient d'eschaton-base et les actions de greffons DMS que
#      cet installeur ne pacstrape pas (revue de sécurité C1) ;
#
#   b) l'action est MASQUÉE. `/etc/polkit-1/actions/` prime sur
#      `/usr/share/polkit-1/actions/` : un fichier de même nom déposé dans
#      `/etc` remplace la politique livrée, silencieusement. Constaté sur
#      polkit 127 (risque n°7 de la spec update graphique). Rien ne le
#      signalait ; on le contrôle donc ici.
#
# On vérifie des FICHIERS, pas `pkaction` : celui-ci lit bien les actions sans
# `polkitd`, mais il lirait celles de l'environnement live, pas celles de
# /mnt. Le contrôle du système démarré est consigné dans tools/vm-dev.md §33.2.
echo "==> Vérification des actions polkit du socle"
polkit_failed=0
for action in org.eschaton.update org.eschaton.rollback; do
  livree="/mnt/usr/share/polkit-1/actions/$action.policy"
  masque="/mnt/etc/polkit-1/actions/$action.policy"
  verify_path "$livree" "l'action polkit $action" || polkit_failed=1
  if [[ "$DRY_RUN" == "1" ]]; then
    echo "DRY: test ! -e $masque   # $action non masquée par /etc"
  elif [[ -e "$masque" ]]; then
    echo "eschaton-install : $action est MASQUÉE par $masque." >&2
    echo "  /etc/polkit-1/actions prime sur /usr/share : la politique livrée" >&2
    echo "  n'est pas celle qui s'applique. Retire ce fichier, ou assume-le" >&2
    echo "  explicitement." >&2
    polkit_failed=1
  else
    echo "    ok : $action n'est masquée par aucun fichier de /etc"
  fi
done
if [[ "$polkit_failed" != "0" ]]; then
  echo "eschaton-install : les binaires privilégiés du socle ne sont pas contraints." >&2
  echo "Ne redémarre pas sans corriger : pkexec retomberait sur l'action générique," >&2
  echo "qui autorise l'authentification depuis une session distante ou inactive." >&2
  exit 1
fi

echo "==> Installation terminée. Redémarre (umount -R /mnt && reboot)."
