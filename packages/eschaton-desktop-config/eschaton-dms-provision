#!/usr/bin/env bash
set -euo pipefail

log() { printf 'eschaton-dms-provision: %s\n' "$*" >&2; }

wallpaper_needs_seed() { # $1=wallpaper DMS courant $2=fichier Eschaton
  [[ -z $1 && -r $2 ]]
}

add_eschaton_widgets() { # $1=settings.json
  local settings=$1 config_dir tmp mode
  config_dir=$(dirname "$settings")
  tmp=$(mktemp "$config_dir/.settings.XXXXXX")
  if ! jq '
    .barConfigs[0].rightWidgets = (
      (.barConfigs[0].rightWidgets // [])
      | if index("eschatonUpdate") then . else . + ["eschatonUpdate"] end
      | if index("eschatonRollback") then . else . + ["eschatonRollback"] end
    )' "$settings" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if ! mode=$(stat -c %a "$settings" 2>/dev/null); then
    mode=$(stat -f %Lp "$settings")
  fi
  chmod "$mode" "$tmp"
  mv "$tmp" "$settings"
}

main() {
  local config_dir settings stamp dms_bin position output current_wallpaper
  local eschaton_wallpaper=/usr/share/backgrounds/eschaton/default.png
  local ready=false
  config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/DankMaterialShell"
  settings="$config_dir/settings.json"
  stamp="$config_dir/.eschaton-plugins-provisioned"
  dms_bin="${ESCHATON_DMS_BIN:-/usr/bin/dms}"

  [[ ! -e "$stamp" ]] || return 0
  [[ -r "$settings" ]] || {
    log "$settings est absent ; provisioning reporté à la prochaine session"
    return 1
  }

  # dms.service peut être actif avant que le serveur IPC et le scan des plugins
  # ne soient prêts. La temporisation est bornée ; aucun marqueur n'est posé en
  # cas d'échec, donc une session ultérieure retentera proprement.
  for _ in {1..45}; do
    if "$dms_bin" ipc call plugins list >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 1
  done
  "$ready" || { log "IPC DMS indisponible après 45 s"; return 1; }

  for plugin in eschatonUpdate eschatonRollback; do
    output=$("$dms_bin" ipc call plugins enable "$plugin") || {
      log "activation de $plugin impossible : $output"
      return 1
    }
  done

  # Forcer une écriture par DMS matérialise dans settings.json sa configuration
  # par défaut complète. On peut alors n'ajouter que nos IDs sans recopier ni
  # figer la longue liste de défauts amont.
  position=$("$dms_bin" ipc call bar getPosition index 0) || {
    log "lecture de la position de barre impossible"
    return 1
  }
  case "$position" in top|bottom|left|right) ;; *)
    log "position de barre inattendue : $position"
    return 1
    ;;
  esac
  "$dms_bin" ipc call bar setPosition index 0 "$position" >/dev/null

  # Le wallpaper amont est un repli interne de DMS : `wallpaper get` rend une
  # chaîne vide, même si une image DMS apparaît. Sur un compte neuf, poser le
  # fond Eschaton via l'IPC officiel. Un choix utilisateur non vide gagne.
  current_wallpaper=$("$dms_bin" ipc call wallpaper get) || {
    log "lecture du fond d'écran DMS impossible"
    return 1
  }
  if wallpaper_needs_seed "$current_wallpaper" "$eschaton_wallpaper"; then
    "$dms_bin" ipc call wallpaper set "$eschaton_wallpaper" >/dev/null || {
      log "activation du fond d'écran Eschaton impossible"
      return 1
    }
  fi

  for _ in {1..10}; do
    if jq -e '.barConfigs[0].rightWidgets | arrays' "$settings" >/dev/null 2>&1; then
      add_eschaton_widgets "$settings"
      : > "$stamp"
      log "plugins Eschaton activés et ajoutés à la barre"
      return 0
    fi
    sleep 1
  done

  log "DMS n'a pas matérialisé barConfigs dans $settings"
  return 1
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
