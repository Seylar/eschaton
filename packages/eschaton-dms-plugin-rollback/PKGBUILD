pkgname=eschaton-dms-plugin-rollback
pkgver=0.1.0
pkgrel=4
pkgdesc="Plugin DMS Eschaton : liste des snapshots et restauration système"
arch=(any)
license=(MIT)
depends=(dms-shell eschaton-base snapper polkit)
# Aucune règle polkit (`rules.d`) n'est livrée : les `<defaults>` de l'action
# suffisent et exigent une authentification. Justification dans l'en-tête de
# org.eschaton.rollback.policy — désormais livré par `eschaton-base`, avec le
# binaire `/usr/bin/eschaton-rollback` qu'il épingle (revue de sécurité C1,
# 2026-08-30). Ce greffon n'est qu'une SURFACE : il ne doit pas être ce qui
# décide si le binaire du socle est contraint, puisqu'il peut parfaitement ne
# pas être installé — l'installeur ne pacstrape que le socle.
source=(plugin.json EschatonRollbackWidget.qml EschatonRollbackSettings.qml LICENSE)
sha256sums=(SKIP SKIP SKIP SKIP)

package() {
  local plugin_dir="$pkgdir/etc/xdg/quickshell/dms-plugins/eschatonRollback"
  install -Dm644 plugin.json "$plugin_dir/plugin.json"
  install -Dm644 EschatonRollbackWidget.qml "$plugin_dir/EschatonRollbackWidget.qml"
  install -Dm644 EschatonRollbackSettings.qml "$plugin_dir/EschatonRollbackSettings.qml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
