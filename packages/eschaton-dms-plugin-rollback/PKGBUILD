pkgname=eschaton-dms-plugin-rollback
pkgver=0.1.0
pkgrel=2
pkgdesc="Plugin DMS Eschaton : liste des snapshots et restauration système"
arch=(any)
license=(MIT)
depends=(dms-shell eschaton-base snapper polkit)
source=(plugin.json EschatonRollbackWidget.qml EschatonRollbackSettings.qml
        org.eschaton.rollback.policy 50-eschaton-rollback.rules LICENSE)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP)

package() {
  local plugin_dir="$pkgdir/etc/xdg/quickshell/dms-plugins/eschatonRollback"
  install -Dm644 plugin.json "$plugin_dir/plugin.json"
  install -Dm644 EschatonRollbackWidget.qml "$plugin_dir/EschatonRollbackWidget.qml"
  install -Dm644 EschatonRollbackSettings.qml "$plugin_dir/EschatonRollbackSettings.qml"
  install -Dm644 org.eschaton.rollback.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.eschaton.rollback.policy"
  install -Dm644 50-eschaton-rollback.rules \
    "$pkgdir/usr/share/polkit-1/rules.d/50-eschaton-rollback.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
