[Match]
Type=ether
# Exclut les interfaces Ethernet virtuelles.
Kind=!*

[Link]
RequiredForOnline=routable

[Network]
DHCP=yes

# systemd-networkd ne pose pas de métrique par défaut selon le type d'interface ;
# on force l'Ethernet devant le Wi-Fi (valeurs de NetworkManager).
[DHCPv4]
RouteMetric=100

[IPv6AcceptRA]
RouteMetric=100
